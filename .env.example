# ResolveAI configuration template.
#
# Copy this file to .env (git-ignored) and fill in the values. Never commit
# .env or put real secrets in this file. Variables already set in the real
# environment take precedence over .env. An empty value means "use the
# default". See app/core/settings.py for the full rules.

# --- Required -------------------------------------------------------------

# JWT signing key, at least 32 characters. Left empty on purpose so the
# application refuses to start until you generate your own, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Optional (defaults shown) --------------------------------------------

# Access-token lifetime in minutes, 1 to 525600.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# development (default), test or production.
APP_ENV=development

# SQLAlchemy database URL. Empty: resolveai.db in the project root.
# A relative SQLite path is resolved against the project root, e.g.
#   DATABASE_URL=sqlite:///data/resolveai.db
# Only SQLite is currently supported.
DATABASE_URL=

# Serve /docs, /redoc and /openapi.json: true or false.
# Empty: enabled in development and test, disabled in production.
ENABLE_API_DOCS=

# Log format: text (default) or json. Reserved; not applied yet.
LOG_FORMAT=text

# Login rate limiting. Reserved; not enforced yet.
# Attempts 1 to 1000; window in seconds, 1 to 86400.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
